{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aeoi://schemas/envelope/0.3",
  "type": "object",
  "required": [
    "spec",
    "status",
    "operator",
    "result",
    "dry_run"
  ],
  "properties": {
    "spec": {
      "const": "aeoi/0.3"
    },
    "status": {
      "enum": [
        "ok",
        "ok_with_warnings",
        "error"
      ]
    },
    "operator": {
      "type": "object",
      "required": [
        "id",
        "version",
        "build"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "build": {
          "type": "string"
        }
      }
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "type": [
        "object",
        "null"
      ],
      "description": "status=error 时必须为 null；结构由算子 output_schema 定义"
    },
    "trust": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/Trust"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Warning"
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "aeoi://schemas/error/0.3"
        }
      ]
    },
    "reproducibility": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/Repro"
        }
      ]
    },
    "timing": {
      "type": "object",
      "properties": {
        "wall_ms": {
          "type": "number"
        },
        "cpu_ms": {
          "type": "number"
        },
        "queue_ms": {
          "type": "number"
        },
        "illustrative": {
          "type": "boolean"
        }
      }
    },
    "dry_run": {
      "type": "boolean",
      "description": "exec.dry_run=true 时为 true；此时 result 为 null，附 estimate"
    },
    "estimate": {
      "type": [
        "object",
        "null"
      ]
    },
    "receipt": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/Receipt"
        }
      ],
      "description": "结果收据（4.3，v0.3.3）：非 dry-run 的成功信封 SHOULD 给出（参考实现总是给出）；错误与 dry-run 信封为 null"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "result": {
            "const": null
          },
          "error": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "ok_with_warnings"
            ]
          },
          "dry_run": {
            "const": false
          }
        },
        "required": [
          "status",
          "dry_run"
        ]
      },
      "then": {
        "required": [
          "trust",
          "reproducibility"
        ],
        "properties": {
          "trust": {
            "type": "object"
          },
          "reproducibility": {
            "type": "object"
          }
        }
      }
    }
  ],
  "$defs": {
    "Trust": {
      "type": "object",
      "required": [
        "convergence",
        "error_estimate",
        "accuracy_grade"
      ],
      "properties": {
        "convergence": {
          "type": "object",
          "required": [
            "applicable"
          ],
          "properties": {
            "applicable": {
              "type": "boolean"
            },
            "converged": {
              "type": "boolean"
            },
            "iterations": {
              "type": "integer"
            },
            "criterion": {
              "type": "string"
            },
            "final_value": {
              "type": "number"
            }
          }
        },
        "residual": {
          "type": [
            "object",
            "null"
          ]
        },
        "condition": {
          "type": [
            "object",
            "null"
          ]
        },
        "error_estimate": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "basis": {
              "type": "string",
              "description": "估计依据：a-priori 界 / a-posteriori 残差 / 嵌入式误差估计 / 无"
            }
          }
        },
        "checks": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "accuracy_grade": {
          "enum": [
            "A",
            "B",
            "C",
            "U"
          ]
        },
        "credentials": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "Warning": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^W\\.[A-Z_]+\\.[A-Z_]+$"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "JSON Pointer，指向相关输入或输出"
        },
        "details": {
          "type": "object"
        },
        "remediation": {
          "type": "array",
          "items": {
            "$ref": "aeoi://schemas/error/0.3#/$defs/Remediation"
          }
        }
      }
    },
    "Repro": {
      "type": "object",
      "required": [
        "determinism",
        "tolerance_class",
        "input_hash",
        "output_hash"
      ],
      "properties": {
        "determinism": {
          "enum": [
            "bitwise",
            "platform_bitwise",
            "tolerance",
            "seeded"
          ]
        },
        "tolerance_class": {
          "enum": [
            "T0",
            "T1",
            "T2",
            "T3",
            "T4",
            "T5",
            "T6"
          ]
        },
        "input_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "output_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "platform": {
          "type": "string"
        },
        "blas": {
          "type": "string"
        },
        "threads": {
          "type": "integer"
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cpu_features": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "影响数值内核分派的 CPU 特性（如 avx2, fma）；platform_bitwise 的“平台”= target triple + 该特性集合"
        }
      }
    },
    "Receipt": {
      "type": "object",
      "required": [
        "format",
        "method",
        "assumptions",
        "exactness",
        "evidence",
        "fingerprint",
        "replay"
      ],
      "properties": {
        "format": {
          "const": "aeoi-receipt/1"
        },
        "method": {
          "type": "object",
          "required": [
            "id",
            "routine",
            "provenance"
          ],
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "routine": {
              "type": [
                "string",
                "null"
              ]
            },
            "provenance": {
              "type": "string",
              "description": "指向 manifest provenance 的 URI"
            }
          }
        },
        "assumptions": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "required": [
              "id",
              "statement",
              "enforced_by"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "statement": {
                "type": "string"
              },
              "enforced_by": {
                "type": "string",
                "description": "validation | error:<code> | check:<key> | warning:<code> | caller（算子不检查，由调用方负责）"
              }
            }
          }
        },
        "exactness": {
          "type": "object",
          "required": [
            "class",
            "bound_kind"
          ],
          "properties": {
            "class": {
              "enum": [
                "exact",
                "correctly_rounded",
                "approximate"
              ]
            },
            "bound_kind": {
              "enum": [
                "rigorous",
                "a_priori",
                "a_posteriori_heuristic",
                "none",
                "none_reported"
              ]
            },
            "bound": {
              "type": [
                "object",
                "null"
              ]
            },
            "basis": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "evidence": {
          "type": "object",
          "required": [
            "claim",
            "postconditions",
            "failed"
          ],
          "properties": {
            "claim": {
              "enum": [
                "verified",
                "spot_checked",
                "unverified",
                "unchecked"
              ],
              "description": "E-11/E-12（v0.3.6）：verified = 声明的后置条件全部为 true 且没有一项只在抽样/压缩后的结果上检查；spot_checked = 全部为 true 但至少一项是 sampled 覆盖，不能表述为“已验证”；unverified = 有后置条件为 false 或缺失；unchecked = 算子没有声明后置条件"
            },
            "postconditions": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            },
            "failed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "approximation": {
              "description": "仅近似算子（v0.3.5 A-2，目前是 control.lti.pade）。抄自 trust.approximation。其他算子不出现此字段。",
              "type": "object"
            },
            "coverage": {
              "description": "v0.3.6 E-12：manifest receipt.coverage 声明了非 full 覆盖时出现。每个后置条件 → full | test_points | sampled",
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "full",
                  "test_points",
                  "sampled"
                ]
              }
            },
            "unreliable": {
              "description": "v0.3.6 E-13：有后置条件失败、且 manifest receipt.guards 为它列出了结果字段时出现：这些 JSON Pointer 指向的结果不可作为结论使用",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "fingerprint": {
          "type": "object",
          "required": [
            "request",
            "result",
            "output_hash",
            "scheme"
          ],
          "properties": {
            "request": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "result": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "output_hash": {
              "type": "string"
            },
            "scheme": {
              "type": "string"
            },
            "stable_across": {
              "type": "string"
            }
          }
        },
        "replay": {
          "type": "object",
          "required": [
            "build",
            "platform"
          ],
          "properties": {
            "build": {
              "type": "string"
            },
            "platform": {
              "type": "string"
            },
            "verify": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
