{
  "spec": "aeoi/0.4",
  "id": "linalg.matrix.inv",
  "version": "0.4.0",
  "title": "Matrix inverse",
  "description": "实方阵的逆矩阵（= MATLAB inv）。LU 分解（部分选主元，与 linalg.system.solve 同一内核），逐列解 A·x_j = e_j，再用补偿算术算残差做至多 3 步迭代精化。结果带每列的后向误差和由返回的逆算出的 1-范数条件数；A 接近奇异时仍返回结果，但发警告，结果没有有效数字时把 X 标为不可依赖。解方程组请用 linalg.system.solve，不要先求逆再相乘（更慢、更不准）。",
  "category": "analysis",
  "tags": [
    "linalg",
    "inverse",
    "inv",
    "matrix"
  ],
  "applicability": {
    "preconditions": [
      "A 为 [n, n] 实数方阵",
      "A 非奇异（LU 主元不为 0）"
    ],
    "not_for": [
      "解线性方程组（用 linalg.system.solve：A⁻¹·b 比直接解更慢、更不准）",
      "非方阵或奇异矩阵的伪逆（用 linalg.matrix.pinv）",
      "复数矩阵（0.4.0 未支持）",
      "大型稀疏矩阵（逆一般是稠密的）"
    ],
    "siso_only": false
  },
  "provenance": {
    "algorithm": "LU 分解 P·A = L·U，部分选主元（每列取 |a_ik| 最大的第一行，与 LAPACK dgetf2 相同）；某步主元恰为 0 报 E.NUMERICAL.SINGULAR。逐列解 A·x_j = e_j；refinement = auto（缺省）时每列再做至多 3 步固定精度迭代精化（残差 e_j − A·x_j 用补偿算术 Dot2，规则同 linalg.system.solve LS-2）。后向误差逐列 η_j = ‖e_j − A·x_j‖∞ / (‖A‖∞‖x_j‖∞ + 1)；κ₁ = ‖A‖₁·‖X‖₁（由返回的 X 直接算，不是估计）；rcond = 1/κ₁ < ε 时 W.NUMERICAL.ILL_CONDITIONED",
    "references": [
      {
        "type": "textbook",
        "cite": "N. J. Higham, Accuracy and Stability of Numerical Algorithms, 2nd ed., SIAM 2002, §9（LU）、§12（迭代精化）、§14（矩阵求逆）、§15（条件数估计）"
      },
      {
        "type": "paper",
        "cite": "T. Ogita, S. M. Rump, S. Oishi, Accurate sum and dot product, SIAM J. Sci. Comput. 26(6), 2005",
        "doi": "10.1137/030601818"
      }
    ],
    "clean_room": {
      "declared": true,
      "sources": "仅公开文献与开源许可兼容的参考；算子命名沿用 MATLAB 的公开函数名，参考数据只来自开源实现（python-control/scipy/mpmath），没有使用 MATLAB 生成数据"
    }
  },
  "backend": {
    "library": "aeoi-numeric (pure Rust)",
    "routine": "matrix::inv",
    "binding": "native",
    "license": "MIT OR Apache-2.0",
    "version": "0.4.0"
  },
  "determinism": "platform_bitwise",
  "tolerance_class": "T1",
  "sparse_support": {
    "/A": {
      "policy": "densify",
      "max_dense_elements": 1000000
    }
  },
  "encodings": {
    "input": [
      "json",
      "b64",
      "ref"
    ],
    "output": [
      "json",
      "b64"
    ]
  },
  "limits": {
    "max_dimension": 1000,
    "max_refinement_steps": 3
  },
  "input_schema": {
    "$ref": "./input.schema.json"
  },
  "output_schema": {
    "$ref": "./output.schema.json"
  },
  "conformance": {
    "target": "L3",
    "current": "L2"
  },
  "accuracy_grade": {
    "target": "A",
    "current": "B"
  },
  "credentials": "aeoi://operators/linalg.matrix.inv/0.4.0/credentials",
  "errors": [
    "E.VALIDATION.SCHEMA",
    "E.VALIDATION.SHAPE",
    "E.VALIDATION.DTYPE",
    "E.VALIDATION.NON_FINITE",
    "E.VALIDATION.DIGEST_MISMATCH",
    "E.VALIDATION.REF_UNSUPPORTED",
    "E.VALIDATION.REF_FORBIDDEN",
    "E.NUMERICAL.SINGULAR",
    "E.RESOURCE.INPUT_TOO_LARGE",
    "E.RESOURCE.TIMEOUT",
    "E.INTERNAL.PANIC",
    "E.VALIDATION.METHOD_UNAVAILABLE"
  ],
  "warnings": [
    "W.NUMERICAL.ILL_CONDITIONED",
    "W.PERFORMANCE.SPARSE_DENSIFIED"
  ],
  "mcp": {
    "tool_name": "linalg_matrix_inv",
    "annotations": {
      "readOnlyHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  "receipt": {
    "method_id": "aeoi:inv:lu-refine",
    "assumptions": [
      {
        "id": "finite",
        "statement": "所有输入数值有限",
        "enforced_by": "error:E.VALIDATION.NON_FINITE"
      },
      {
        "id": "square",
        "statement": "A 为方阵",
        "enforced_by": "error:E.VALIDATION.SHAPE"
      },
      {
        "id": "nonsingular",
        "statement": "A 非奇异",
        "enforced_by": "error:E.NUMERICAL.SINGULAR"
      },
      {
        "id": "conditioning",
        "statement": "κ·u ≪ 1，否则 X 没有有效数字（前向误差 ≈ κ·η）",
        "enforced_by": "warning:W.NUMERICAL.ILL_CONDITIONED"
      },
      {
        "id": "row_major",
        "statement": "A 按 row-major 录入",
        "enforced_by": "caller"
      }
    ],
    "exactness": {
      "class": "approximate",
      "bound_kind": "a_posteriori_heuristic"
    },
    "postconditions": [
      "backward_stable",
      "forward_error_below_one",
      "all_finite"
    ],
    "coverage": {
      "backward_stable": "full",
      "forward_error_below_one": "full"
    },
    "guards": {
      "backward_stable": [
        "/X"
      ],
      "forward_error_below_one": [
        "/X"
      ]
    }
  }
}
