{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aeoi://schemas/control.analysis.margin/0.3.0/output",
  "type": "object",
  "required": [
    "gain_margin",
    "gain_margin_db",
    "phase_margin",
    "stability_margin",
    "phase_crossover_frequency",
    "gain_crossover_frequency",
    "stability_margin_frequency",
    "crossings",
    "closed_loop_stable"
  ],
  "properties": {
    "gain_margin": {
      "$ref": "aeoi://schemas/common/0.4#/$defs/Quantity",
      "description": "unit=1（幅值比）；无相位交越时为 \"Inf\""
    },
    "gain_margin_db": {
      "$ref": "aeoi://schemas/common/0.4#/$defs/Quantity",
      "description": "unit=dB"
    },
    "phase_margin": {
      "$ref": "aeoi://schemas/common/0.4#/$defs/Quantity",
      "description": "unit=deg；无增益交越时为 \"Inf\""
    },
    "stability_margin": {
      "$ref": "aeoi://schemas/common/0.4#/$defs/Quantity",
      "description": "unit=1，min_ω |1+G|；无内部极小时为 \"Inf\""
    },
    "phase_crossover_frequency": {
      "$ref": "aeoi://schemas/common/0.4#/$defs/Quantity",
      "description": "unit=rad/s，所选 GM 对应频率；无则 \"NaN\""
    },
    "gain_crossover_frequency": {
      "$ref": "aeoi://schemas/common/0.4#/$defs/Quantity",
      "description": "unit=rad/s"
    },
    "stability_margin_frequency": {
      "$ref": "aeoi://schemas/common/0.4#/$defs/Quantity",
      "description": "unit=rad/s"
    },
    "crossings": {
      "type": "object",
      "required": [
        "phase",
        "gain",
        "stability"
      ],
      "properties": {
        "phase": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "gain": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "stability": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "description": "全部交越点（升序），每项含 w_rad_s 与对应裕度"
    },
    "closed_loop_stable": {
      "type": "boolean",
      "description": "负单位反馈闭环 n+d 的根是否全部稳定"
    }
  }
}
