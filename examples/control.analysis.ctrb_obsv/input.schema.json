{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aeoi://schemas/control.analysis.ctrb_obsv/0.3.0/input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "system"
  ],
  "properties": {
    "system": {
      "$ref": "aeoi://schemas/common/0.3/LtiSystem",
      "description": "被分析的 LTI 系统：tf（num/den 按降幂）、ss（A/B/C/D 稠密矩阵，row-major）或 zpk；ts=0 连续，ts>0 为离散采样周期（s）"
    },
    "gramians": {
      "type": "boolean",
      "default": false,
      "description": "是否额外计算可控/可观 Gramian（要求系统稳定），默认 false"
    },
    "rank_rtol": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "相对秩容差 σ_i > rank_rtol·σ_max；缺省 max(行,列)·ε"
    },
    "exec": {
      "$ref": "aeoi://schemas/common/0.3/ExecOptions"
    }
  }
}
