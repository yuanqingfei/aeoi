{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aeoi://schemas/control.lti.convert/0.3.0/input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "system",
    "to"
  ],
  "properties": {
    "system": {
      "$ref": "aeoi://schemas/common/0.3/LtiSystem"
    },
    "to": {
      "enum": [
        "tf",
        "ss",
        "zpk"
      ]
    },
    "normalize": {
      "type": "boolean",
      "default": true,
      "description": "tf 输出时把每个分母归一为首一（monic）"
    },
    "exec": {
      "$ref": "aeoi://schemas/common/0.3/ExecOptions"
    }
  }
}
