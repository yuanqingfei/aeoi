{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aeoi://schemas/control.math.lyap/0.4.0/input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "A",
    "Q"
  ],
  "properties": {
    "A": {
      "$ref": "aeoi://schemas/common/0.4#/$defs/Matrix",
      "description": "系数矩阵 A，[n,n]"
    },
    "Q": {
      "$ref": "aeoi://schemas/common/0.4#/$defs/Matrix",
      "description": "右端矩阵 Q，[n,n]。可以不对称：按原样求解，不对称化（10.10）。Q 对称时解 X 也对称"
    },
    "type": {
      "enum": [
        "continuous",
        "discrete"
      ],
      "default": "continuous",
      "description": "continuous：A X + X Aᵀ + Q = 0；discrete：A X Aᵀ − X + Q = 0"
    },
    "exec": {
      "$ref": "aeoi://schemas/common/0.4#/$defs/ExecOptions"
    }
  },
  "x-aeoi-shape-constraints": [
    "A: [n,n]",
    "Q: [n,n]"
  ]
}
