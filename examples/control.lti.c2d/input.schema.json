{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aeoi://schemas/control.lti.c2d/0.3.0/input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "system",
    "ts"
  ],
  "properties": {
    "system": {
      "$ref": "aeoi://schemas/common/0.4#/$defs/LtiSystem",
      "description": "待离散化的连续系统（ts 必须为 0）"
    },
    "ts": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "采样周期 T（单位 s，> 0）。必须是用户在对话中明确给出的数值；用户没给时不要调用本工具，先询问用户，绝不假设 0.1、0.01 等常用值",
      "x-aeoi-provenance": "user"
    },
    "method": {
      "enum": [
        "zoh",
        "foh",
        "tustin"
      ],
      "default": "zoh",
      "description": "离散化方法：zoh（零阶保持，默认）、foh（一阶保持/三角保持）、tustin（双线性，可配合 prewarp_frequency）"
    },
    "prewarp_frequency": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "rad/s，仅 tustin"
    },
    "output_kind": {
      "enum": [
        "same",
        "tf",
        "ss",
        "zpk"
      ],
      "default": "same",
      "description": "输出表示：same（与输入相同，默认）、tf、ss、zpk"
    },
    "exec": {
      "$ref": "aeoi://schemas/common/0.4#/$defs/ExecOptions"
    }
  }
}
