{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aeoi://schemas/linalg.matrix.norm/0.4.0/input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "x"
  ],
  "properties": {
    "x": {
      "$ref": "aeoi://schemas/common/0.4#/$defs/Matrix",
      "description": "向量 [n]（[1, n]、[n, 1] 也按向量处理，同 MATLAB）或矩阵 [m, n]，row-major"
    },
    "p": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 1
        },
        {
          "enum": [
            "inf",
            "-inf",
            "fro"
          ]
        }
      ],
      "default": 2,
      "x-aeoi-provenance": "convention",
      "description": "范数类型：向量可为任意 p ≥ 1、\"inf\"、\"-inf\"、\"fro\"；矩阵为 1、2（缺省）、\"inf\"、\"fro\""
    },
    "exec": {
      "$ref": "aeoi://schemas/common/0.4#/$defs/ExecOptions"
    }
  },
  "x-aeoi-shape-constraints": [
    "x: [n]、[1, n]、[n, 1]（向量）或 [m, n]（矩阵）"
  ]
}
