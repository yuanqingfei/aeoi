{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aeoi://schemas/fit.poly.polyval/0.4.0/input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "p",
    "x"
  ],
  "properties": {
    "p": {
      "$ref": "aeoi://schemas/common/0.4#/$defs/Matrix",
      "description": "系数 [n + 1]，最高次在前（x² − 3x + 2 写成 [1, −3, 2]）"
    },
    "x": {
      "$ref": "aeoi://schemas/common/0.4#/$defs/Matrix",
      "description": "求值点 [q]（单个点写成 [1]）"
    },
    "mu": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2,
      "x-aeoi-provenance": "supplied",
      "description": "可选：fit.poly.polyfit（scaling = center_scale）结果里的 mu = [mean, std]，原样粘贴；给了就在 (x − mu[0])/mu[1] 处求值"
    },
    "exec": {
      "$ref": "aeoi://schemas/common/0.4#/$defs/ExecOptions"
    }
  },
  "x-aeoi-shape-constraints": [
    "p: [n + 1]",
    "x: [q]"
  ]
}
