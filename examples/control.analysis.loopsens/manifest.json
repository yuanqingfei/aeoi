  "receipt": {
    "method_id": "aeoi:loopsens:connect+margin+stepinfo",
    "assumptions": [
      {
        "id": "lti_model",
        "statement": "plant、controller、sensor 准确描述回路（单位、符号、row-major 录入）",
        "enforced_by": "caller"
      },
      {
        "id": "topology",
        "statement": "单回路负反馈 r → e = r − H·y → C → G → y",
        "enforced_by": "validation"
      },
      {
        "id": "finite",
        "statement": "所有输入数值有限",
        "enforced_by": "error:E.VALIDATION.NON_FINITE"
      },
      {
        "id": "same_ts",
        "statement": "三个系统采样周期相同",
        "enforced_by": "error:E.DOMAIN.SAMPLE_TIME_MISMATCH"
      },
      {
        "id": "siso",
        "statement": "SISO",
        "enforced_by": "error:E.DOMAIN.MIMO_NOT_SUPPORTED"
      },
      {
        "id": "proper_for_metrics",
        "statement": "裕度与阶跃指标要求 L、T proper，否则该项为 null",
        "enforced_by": "warning:W.DOMAIN.ANALYSIS_SKIPPED"
      },
      {
        "id": "definitions",
        "statement": "带宽、阶跃阈值用请求里的值；省略则是规范默认 −3 dB、10–90%、2%",
        "enforced_by": "validation"
      },
      {
        "id": "no_cancel",
        "statement": "不做零极点对消",
        "enforced_by": "caller"
      }
    ],
    "exactness": {
      "class": "approximate",
      "bound_kind": "a_posteriori_heuristic"
    },
    "postconditions": [
      "closed_loop_identity",
      "stability_consistent",
      "all_finite",
      "sub_operator_checks"
    ],
    "coverage": {
      "closed_loop_identity": "test_points",
      "sub_operator_checks": "sampled"
    },
    "guards": {
      "closed_loop_identity": [
        "/open_loop",
        "/closed_loop",
        "/sensitivity"
      ],
      "stability_consistent": [
        "/closed_loop_stable"
      ],
      "sub_operator_checks": [
        "/margins",
        "/gain_crossover_rad_s",
        "/gain_crossover_hz",
        "/step_metrics"
      ]
    }
  }
