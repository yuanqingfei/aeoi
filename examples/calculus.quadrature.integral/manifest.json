    "current": "L2"
  },
  "accuracy_grade": {
    "target": "A",
    "current": "B"
  },
  "credentials": "aeoi://operators/calculus.quadrature.integral/0.4.0/credentials",
  "errors": [
    "E.VALIDATION.SCHEMA",
    "E.VALIDATION.RANGE",
    "E.VALIDATION.EXPRESSION",
    "E.NUMERICAL.NON_FINITE_EVALUATION",
    "E.NUMERICAL.NO_CONVERGENCE",
    "E.RESOURCE.TIMEOUT",
