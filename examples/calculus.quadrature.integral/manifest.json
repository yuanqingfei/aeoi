      },
      {
        "id": "error_estimate_heuristic",
        "statement": "误差估计是启发式的；可能漏掉区间里窄的尖峰",
        "enforced_by": "check:refinement_consistent"
      }
    ],
    "exactness": {
      "class": "approximate",
      "bound_kind": "a_posteriori_heuristic"
    },
    "postconditions": [
