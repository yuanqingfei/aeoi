{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aeoi://schemas/control.lti.feedback/0.3.0/input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sys1"
  ],
  "properties": {
    "sys1": {
      "$ref": "aeoi://schemas/common/0.3/LtiSystem",
      "description": "前向通道。省略 sys2 时必须是方的（单位反馈）"
    },
    "sys2": {
      "$ref": "aeoi://schemas/common/0.3/LtiSystem",
      "description": "反馈通道。省略表示单位增益 D=I。负反馈是默认，不是把 sys2 写成负号"
    },
    "output_kind": {
      "enum": [
        "same",
        "tf",
        "ss"
      ],
      "default": "same",
      "description": "same（默认）、tf 或 ss"
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "description": "可选。上游 receipt.fingerprint.request，只回显，不核验"
    },
    "sign": {
      "enum": [
        -1,
        1
      ],
      "default": -1,
      "x-aeoi-provenance": "convention",
      "description": "反馈符号，只能是 -1（负反馈，默认，规范定义）或 +1（正反馈）。这是定义默认值，不是测量值，不需要引用用户原话"
    },
    "exec": {
      "$ref": "aeoi://schemas/common/0.3/ExecOptions"
    }
  }
}
