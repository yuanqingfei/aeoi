{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aeoi://schemas/control.lti.poles_zeros/0.3.0/input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "system"
  ],
  "properties": {
    "system": {
      "$ref": "aeoi://schemas/common/0.3/LtiSystem",
      "description": "被分析的 LTI 系统：tf（num/den 按降幂）、ss（A/B/C/D 稠密矩阵，row-major）或 zpk；ts=0 连续，ts>0 为离散采样周期（s）"
    },
    "dcgain": {
      "type": "boolean",
      "default": true,
      "description": "是否计算直流增益（连续 s=0，离散 z=1），默认 true"
    },
    "exec": {
      "$ref": "aeoi://schemas/common/0.3/ExecOptions"
    }
  }
}
